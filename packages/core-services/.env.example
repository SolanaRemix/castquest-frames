# =============================================================================
# CASTQUEST CORE SERVICES - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control
#
# All environment variables are placeholders - update after deployment
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
POSTGRES_HOST=your-postgres-host.com
POSTGRES_PORT=5432
POSTGRES_DB=castquest
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here_use_strong_random_string
SESSION_SECRET=your_session_secret_here_use_strong_random_string
API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Blockchain Configuration (Base L2)
# -----------------------------------------------------------------------------
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
PRIVATE_KEY=your_private_key_here_for_contract_interactions

# Contract Addresses
CASTQUEST_PROTOCOL_ADDRESS=0x0000000000000000000000000000000000000000
CAST_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# Farcaster Configuration
# -----------------------------------------------------------------------------
FARCASTER_HUB_URL=https://hub.farcaster.xyz
FARCASTER_SIGNER_KEY=your_farcaster_signer_key_here
FARCASTER_FID=your_farcaster_id_here

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# IPFS / Pinata
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Alternative: Web3.Storage
# WEB3_STORAGE_TOKEN=your_web3_storage_token_here

# -----------------------------------------------------------------------------
# Email Configuration (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@your-domain.com

# -----------------------------------------------------------------------------
# Smart Brain Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ORACLE_POSTGRES_URL=postgresql://user:password@host:port/oracle?sslmode=require

# AI Feature Flags
ENABLE_AI_PRICING=true
ENABLE_AI_RISK_SCORING=true
ENABLE_AI_CONTENT_MODERATION=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://your-domain.vercel.app,https://admin.your-domain.vercel.app
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Redis Configuration (Optional for caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://user:password@host:port
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
ENABLE_WORKERS=true
WORKER_CONCURRENCY=5
QUEUE_URL=your_queue_url_here

# -----------------------------------------------------------------------------
# Protocol Configuration
# -----------------------------------------------------------------------------
# Protocol fees: 250 BPS = 2.5%
# Creator fees: 500 BPS = 5.0%
# Total fees: 750 BPS = 7.5% (combined)
# Note: Ensure combined fees don't exceed MAX_TOTAL_FEE_BPS (typically 1000 = 10%)
DEFAULT_PROTOCOL_FEE_BPS=250
DEFAULT_CREATOR_FEE_BPS=500
MIN_MEDIA_PRICE=0.001
MAX_MEDIA_PRICE=1000

# -----------------------------------------------------------------------------
# Health Check
# -----------------------------------------------------------------------------
HEALTH_CHECK_INTERVAL=30000
ENABLE_HEALTH_ENDPOINT=true
