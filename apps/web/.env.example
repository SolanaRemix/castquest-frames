# =============================================================================
# CastQuest Web App - Environment Variables Template
# =============================================================================
# Copy this file to .env.local for local development
# Configure these variables in Vercel Dashboard for production deployment
# See DEPLOYMENT.md for detailed instructions
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (Optional)
# -----------------------------------------------------------------------------
# Privy Authentication - Get your App ID from https://console.privy.io/
# NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# CastQuest API Key for internal service authentication
CASTQUEST_API_KEY=your_castquest_api_key_here

# Admin API Token for administrative operations
ADMIN_API_TOKEN=your_admin_api_token_here

# Public API URL for client-side requests (optional)
# NEXT_PUBLIC_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Database Configuration (Optional)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/castquest

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
# Set to 'production' for production deployments
# NODE_ENV=development
